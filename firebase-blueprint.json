{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/firestore-blueprint.json",
  "entities": {
    "Maestro": {
      "title": "Maestro",
      "description": "Local trade craftsman or home service professional in Querétaro (Maestro Cerca canonical profile)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "oficio": { "type": "string" },
        "bio": { "type": "string" },
        "calificacion": { "type": "number" },
        "radioKm": { "type": "number" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "fotoUrl": { "type": "string" },
        "telefonoWhatsApp": { "type": "string" },
        "nivel": { "type": "string" },
        "verificado": { "type": "boolean" },
        "aprobado": { "type": "boolean" },
        "statusPerfil": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "fechaRegistro": { "type": "string" },
        "userId": { "type": "string" },
        "servicios": { "type": "array" },
        "fotosTrabajos": { "type": "array" }
      },
      "required": ["id", "nombre", "oficio", "telefonoWhatsApp", "verificado", "aprobado"]
    },
    "SolicitudContacto": {
      "title": "SolicitudContacto",
      "description": "Lead and contact analytics event for WhatsApp or phone clicks in Maestro Cerca",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "maestroId": { "type": "string" },
        "fecha": { "type": "string" },
        "timestamp": { "type": "string" },
        "origen": { "type": "string" },
        "tipo": { "type": "string" },
        "telefono": { "type": "string" },
        "maestroNombre": { "type": "string" },
        "oficio": { "type": "string" }
      },
      "required": ["maestroId", "fecha", "origen"]
    },
    "PreWorker": {
      "title": "PreWorker",
      "description": "Preliminary worker profile received from ManyChat WhatsApp flow, awaiting Firebase Phone Auth verification and claiming",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "phone": { "type": "string" },
        "whatsappPhone": { "type": "string" },
        "nombre": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "ciudad": { "type": "string" },
        "serviceAreas": { "type": "array" },
        "oficio": { "type": "string" },
        "mainTrade": { "type": "string" },
        "servicios": { "type": "array" },
        "yearsExperience": { "type": "number" },
        "disponibilidad": { "type": "string" },
        "telefonoPublico": { "type": "string" },
        "profilePhoto": { "type": "string" },
        "workPhotos": { "type": "array" },
        "fotosTrabajos": { "type": "array" },
        "manychatUserId": { "type": "string" },
        "privacyNoticeAccepted": { "type": "boolean" },
        "source": { "type": "string" },
        "status": { "type": "string" },
        "profileType": { "type": "string" },
        "verificado": { "type": "boolean" },
        "claimedByUid": { "type": "string" },
        "claimedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "phoneNumber", "nombre", "oficio", "source", "status", "profileType", "verificado"]
    },
    "ReportePerfil": {
      "title": "ReportePerfil",
      "description": "User report submitted against a worker profile for administrator review",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workerId": { "type": "string" },
        "workerSlug": { "type": "string" },
        "workerNameSnapshot": { "type": "string" },
        "workerTradeSnapshot": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["workerId", "reason", "status", "createdAt"]
    }
  },
  "firestore": {
    "/maestros/{maestroId}": {
      "schema": "Maestro",
      "description": "Canonical profile of registered and verified trade workers in Querétaro"
    },
    "/maestros/{maestroId}/privado/{docId}": {
      "schema": "Maestro",
      "description": "Private media metadata and review statuses accessible only to worker owner and administrators"
    },
    "/solicitudes_contacto/{solicitudId}": {
      "schema": "SolicitudContacto",
      "description": "Lead and direct contact request records"
    },
    "/preWorkers/{preWorkerId}": {
      "schema": "PreWorker",
      "description": "Preliminary WhatsApp worker profiles from ManyChat awaiting authentication claiming"
    },
    "/reportes_perfil/{reportId}": {
      "schema": "ReportePerfil",
      "description": "User profile reports submitted by visitors for admin review"
    },
    "/trades/{tradeId}": {
      "schema": "Trade",
      "description": "Catalog of supported trades"
    },
    "/serviceAreas/{areaId}": {
      "schema": "ServiceArea",
      "description": "Catalog of supported service zones"
    },
    "/analytics/{docId}": {
      "schema": "Analytics",
      "description": "Platform telemetry and aggregated statistics"
    }
  },
  "collections": {
    "maestros": {
      "description": "Canonical collection of trade workers in Maestro Cerca",
      "fields": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "oficio": { "type": "string" },
        "bio": { "type": "string" },
        "calificacion": { "type": "number" },
        "radioKm": { "type": "number" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "fotoUrl": { "type": "string" },
        "telefonoWhatsApp": { "type": "string" },
        "nivel": { "type": "string" },
        "verificado": { "type": "boolean" },
        "aprobado": { "type": "boolean" },
        "statusPerfil": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "fechaRegistro": { "type": "string" }
      }
    },
    "preWorkers": {
      "description": "Preliminary ManyChat WhatsApp worker leads pending claiming",
      "fields": {
        "id": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "nombre": { "type": "string" },
        "oficio": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "solicitudes_contacto": {
      "description": "Direct WhatsApp and phone contact requests initiated from the platform",
      "fields": {
        "id": { "type": "string" },
        "maestroId": { "type": "string" },
        "fecha": { "type": "string" },
        "timestamp": { "type": "string" },
        "origen": { "type": "string" }
      }
    },
    "reportes_perfil": {
      "description": "Visitor reports on worker profiles for moderation",
      "fields": {
        "id": { "type": "string" },
        "workerId": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string" }
      }
    }
  }
}
