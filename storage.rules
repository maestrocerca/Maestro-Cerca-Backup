rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: Checks if request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Checks if user possesses administrator privileges
    // Only Firebase Custom Claim admin == true authorizes administrative operations
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.admin == true;
    }

    // =========================================================================
    // 1. PENDING PROFILE PHOTOS (Private, Pre-Moderation)
    // Path: /profile-photos-pending/{uid}/{fileName}
    // Threat Vectors Addressed:
    // - Unmoderated / Inappropriate Avatars: READ IS STRICTLY OWNER OR ADMIN ONLY.
    //   Never publicly accessible or readable by anonymous visitors.
    // - Malware / Script Injection: Strict MIME-type regex image/(jpeg|png|webp).
    // - Storage Exhaustion (DoS): Strictly capped at < 5MB.
    // - Path Traversal / Spoofing: request.auth.uid must match target uid.
    // =========================================================================
    match /profile-photos-pending/{uid}/{fileName} {
      allow read: if (isAuthenticated() && request.auth.uid == uid) || isAdmin();
      allow write: if isAuthenticated() 
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if (isAuthenticated() && request.auth.uid == uid) || isAdmin();
    }

    // =========================================================================
    // 2. PUBLIC APPROVED PROFILE PHOTOS (Post-Moderation)
    // Path: /profile-photos-public/{uid}/{fileName}
    // Threat Vectors Addressed:
    // - Read: Fully public for verified & approved worker avatars.
    // - Write / Mutation: ADMIN ONLY (via Admin SDK / controlled endpoint).
    //   Workers cannot write directly to public avatars without administrative approval.
    // =========================================================================
    match /profile-photos-public/{uid}/{fileName} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // =========================================================================
    // 3. PUBLIC WORK GALLERY PORTFOLIO (Photos of completed jobs)
    // Path: /portafolios/{folderId}/{fileName}
    // =========================================================================
    match /portafolios/{folderId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() 
        && request.auth.uid == folderId
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if (isAuthenticated() && request.auth.uid == folderId) || isAdmin();
    }

    // =========================================================================
    // 4. CONFIDENTIAL VERIFICATION DOCUMENTS (Sensitive INE, Passports, Proofs)
    // Path: /verificaciones/{uid}/{fileName}
    // Threat Vectors Addressed:
    // - Identity Theft / PII Data Leakage: READ IS STRICTLY ADMIN-ONLY (isAdmin()).
    //   Never publicly queryable or accessible to third parties.
    // - File Type Restrictions: Only image/jpeg, image/png, image/webp or application/pdf.
    // - Storage Quota Protection: Hard cap at < 10MB.
    // =========================================================================
    match /verificaciones/{uid}/{fileName} {
      // Read: Admin ONLY. Never publicly queryable.
      allow read: if isAdmin();
      
      // Write: Authenticated worker uploading their own verification credentials
      allow write: if isAuthenticated() 
        && request.auth.uid == uid
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp)') || 
          request.resource.contentType == 'application/pdf'
        )
        && request.resource.size < 10 * 1024 * 1024;

      allow delete: if isAdmin();
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

