# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MANYCHAT_WEBHOOK_SECRET: Secret token used to authenticate ManyChat / WhatsApp webhook registrations.
# In ManyChat External Request, configure request header:
#   x-api-key: <MANYCHAT_WEBHOOK_SECRET>
# NOTA: El valor real debe configurarse exclusivamente en las variables de entorno del despliegue (hosting/secrets) y NUNCA en el repositorio.
MANYCHAT_WEBHOOK_SECRET="REEMPLAZAR_CON_SECRETO_REAL"

# MANYCHAT_ACCOUNT_ACTION_SECRET: SEPARATE secret, only for the account status/
# pause/resume/delete endpoint (/api/manychat/account-action). Deliberately
# different from MANYCHAT_WEBHOOK_SECRET so that if the webhook secret (used
# in many more ManyChat steps, wider leak surface) ever leaks, an attacker
# still cannot trigger the irreversible account deletion action.
# In ManyChat, configure this ONLY on the External Request steps that call
# /api/manychat/account-action, as header:
#   x-api-key: <MANYCHAT_ACCOUNT_ACTION_SECRET>
# NOTA: El valor real debe configurarse exclusivamente en las variables de entorno del despliegue (hosting/secrets) y NUNCA en el repositorio.
MANYCHAT_ACCOUNT_ACTION_SECRET="REEMPLAZAR_CON_OTRO_SECRETO_REAL_DISTINTO"

# MANYCHAT_API_TOKEN: ManyChat's own account-level API token (Settings -> API
# in the ManyChat dashboard), used ONLY to clear a deleted worker's personal
# data (name, trade, photos, etc.) out of ManyChat's custom fields when their
# account is deleted, from either WhatsApp or the website. Optional: if not
# set, account deletion still works fully, it just skips the ManyChat-side
# cleanup step.
MANYCHAT_API_TOKEN="REEMPLAZAR_CON_TOKEN_DE_MANYCHAT"

