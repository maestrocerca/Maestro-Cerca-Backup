rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS (Zero-Trust Cryptographic Authorization)
    // =========================================================================
    
    // Checks if request is from an authenticated user session
    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks if authenticated user possesses administrator privileges
    // Only Firebase Custom Claim admin == true authorizes administrative operations
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.admin == true;
    }

    // Checks if the authenticated user owns this specific maestro document
    function isMaestroOwner(maestroId) {
      return isAuthenticated() && (
        request.auth.uid == maestroId || 
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // Checks if the authenticated user owns the parent maestro or is owner of the private dossier
    function canAccessPrivadoDoc(maestroId) {
      return isAuthenticated() && (
        request.auth.uid == maestroId ||
        (request.resource != null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/maestros/$(maestroId)) &&
         get(/databases/$(database)/documents/maestros/$(maestroId)).data.userId == request.auth.uid)
      );
    }

    // =========================================================================
    // 1. MAESTROS COLLECTION
    // Threat Vectors Addressed:
    // - Catalog Integrity: Public queries only see approved profiles (aprobado == true).
    // - Unauthorized Privilege Escalation: Profile owners CANNOT alter aprobado,
    //   verificado, calificacion, or nivel fields.
    // - Destructive Actions: Non-admins cannot delete profiles.
    // - Unverified Self-Registration: New records MUST start as unapproved & unverified.
    // =========================================================================
    match /maestros/{maestroId} {
      // Read access: Public access strictly constrained to approved profiles.
      // Administrators and profile owners can read all/unapproved documents.
      allow list: if (resource != null && resource.data.aprobado == true) || isAdmin();
      allow get: if isMaestroOwner(maestroId) || (resource != null && resource.data.aprobado == true) || isAdmin();

      // Create: Authenticated users can register with initial state strictly constrained.
      // Incoming data MUST have aprobado == false and verificado == false.
      // Strictly enforce that maestroId equals authenticated user's UID (1 human = 1 UID = 1 doc).
      // ANTI-FORGERY: If phoneVerified is claimed as true, request.auth.token.phone_number MUST NOT be null.
      allow create: if (
        isAuthenticated() && 
        request.auth.uid == maestroId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.aprobado == false &&
        request.resource.data.verificado == false &&
        (
          request.resource.data.get('phoneVerified', false) != true ||
          request.auth.token.phone_number != null
        )
      ) || isAdmin();

      // Update: 
      // - Administrators can modify any field.
      // - Profile owners CANNOT modify critical governance and verification fields:
      //   ['aprobado', 'statusPerfil', 'verificado', 'calificacion', 'nivel', 'verificationStatus', 'identityVerified', 'referencesVerified', 'photosReviewed', 'phoneVerified', 'phoneVerifiedAt', 'phoneVerificationMethod', 'authProviders']
      // - Non-administrators can NEVER set profilePhotoReviewStatus to 'approved' directly
      allow update: if (
        isMaestroOwner(maestroId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'aprobado', 
          'statusPerfil',
          'verificado', 
          'calificacion', 
          'nivel',
          'verificationStatus',
          'identityVerified',
          'referencesVerified',
          'photosReviewed',
          'phoneVerified',
          'phoneVerifiedAt',
          'phoneVerificationMethod',
          'authProviders'
        ]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['profilePhotoReviewStatus']) ||
          request.resource.data.profilePhotoReviewStatus == 'pending'
        )
      ) || isAdmin();

      // Public counter increment: anyone (including anonymous visitors) may bump contactCount
      // by exactly +1 when they tap WhatsApp/phone on a profile. No other field may change in
      // the same write, so this can never be used to alter any other part of the profile.
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contactCount']) &&
        request.resource.data.contactCount == (resource.data.contactCount is int ? resource.data.contactCount : 0) + 1;

      // Delete: Owner or Admin allowed for account self-deletion & privacy rights
      allow delete: if isMaestroOwner(maestroId) || isAdmin();

      // Private media and verification subcollection (never accessible to public visitors)
      match /privado/{docId} {
        allow read: if canAccessPrivadoDoc(maestroId) || isAdmin();
        allow create, update: if (
          canAccessPrivadoDoc(maestroId) &&
          (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status == 'pending') &&
          (!request.resource.data.keys().hasAny(['profilePhotoReviewStatus']) || request.resource.data.profilePhotoReviewStatus == 'pending') &&
          !request.resource.data.keys().hasAny(['verified', 'approved', 'identityVerified', 'referencesVerified', 'photosReviewed', 'verifiedAt', 'verifiedBy', 'adminNotes'])
        ) || isAdmin();
        allow delete: if canAccessPrivadoDoc(maestroId) || isAdmin();
      }
    }

    // =========================================================================
    // REPORTES_PERFIL COLLECTION (User Profile Reports)
    // Read: Strictly Admin only.
    // Write: Admin only (written via secure backend /api/profile-reports endpoint).
    // =========================================================================
    match /reportes_perfil/{reportId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 3. PRE_WORKERS COLLECTION (ManyChat / WhatsApp Preliminary Registrations)
    // Threat Vectors Addressed:
    // - Never auto-verified: verificado MUST be false at creation.
    // - Claim integrity: Only the authenticated user whose verified phone matches
    //   can claim the preWorker, setting status to 'claimed' and claimedByUid.
    // - Anti-hijack: Once claimed, no other UID can claim or overwrite the preWorker.
    // =========================================================================
    match /preWorkers/{preWorkerId} {
      // Read access: Admin can list/get all; authenticated users can only get if they claimed it or match verified phone
      allow list: if isAdmin();
      allow get: if isAdmin() || (
        isAuthenticated() && (
          resource.data.claimedByUid == request.auth.uid ||
          resource.data.phoneNumber == request.auth.token.phone_number
        )
      );

      // Create: Admin only (ManyChat webhook and import write via Admin SDK on the server)
      allow create: if isAdmin();

      // Update: Admin or authenticated user claiming their own preliminary profile with restricted keys
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.status == 'pending_claim' &&
        request.resource.data.status == 'claimed' &&
        request.resource.data.claimedByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedByUid', 'claimedAt', 'updatedAt'])
      );

      // Delete: Admin only
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 4. SOLICITUDES_CONTACTO COLLECTION (Lead Analytics & Telemetry)
    // Threat Vectors Addressed:
    // - Competitor Lead Scraping: 100% blocked (read access is Admin-only).
    // - Payload Flooding / Malicious Payloads: Creation strictly validates required
    //   origin token ('maestro_cerca_web' or 'zibata_web'), maestroId, timestamp, and field whitelist.
    // =========================================================================
    match /solicitudes_contacto/{solicitudId} {
      // Public creation allowed ONLY if required fields exist and payload has no extraneous tokens
      allow create: if request.resource.data.keys().hasAll(['maestroId', 'origen', 'timestamp'])
        && request.resource.data.origen in ['maestro_cerca_web', 'zibata_web']
        && request.resource.data.maestroId is string
        && request.resource.data.keys().hasOnly([
          'id', 
          'maestroId', 
          'maestroNombre', 
          'oficio', 
          'origen', 
          'telefono', 
          'tipo', 
          'timestamp', 
          'fecha', 
          'userIp', 
          'userAgent'
        ]);

      // Read, update, and delete access strictly limited to administrators
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // 5. TRADES & SERVICE AREAS (Catalog metadata)
    // =========================================================================
    match /trades/{tradeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /serviceAreas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /catalogos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }

    // Default deny all other unspecified documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

